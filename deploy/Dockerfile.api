# Den API — Fastify + socket.io + media workers.
# Build context is the repo root (see docker-compose.yml).

FROM node:22-slim AS build
WORKDIR /repo
# Manifests first for layer caching.
# All workspace manifests must be present for npm to resolve the workspace
# tree, even though this image only builds shared + server.
#
# `npm ci`, with the lockfile REQUIRED (no `package-lock.json*` glob): the
# image gets exactly the dependency versions the repo was tested with, and a
# package.json that drifted from the lockfile fails the build loudly instead
# of quietly resolving new versions on the prod host. Plain `npm ci` installs
# the root plus every workspace listed in the one root lockfile.
COPY package.json package-lock.json tsconfig.base.json ./
COPY shared/package.json shared/
COPY server/package.json server/
COPY app/package.json app/
RUN npm ci
# Sources
COPY shared/ shared/
COPY server/ server/
RUN npm -w shared run build && npm -w server run build

FROM node:22-slim AS runtime
WORKDIR /repo
ENV NODE_ENV=production
# ffmpeg: voice transcode + video posters. libvips: sharp's HEIC/AVIF decode
# (sharp's prebuilt binary bundles libvips itself, but the system lib covers
# HEIC — verify on the real VPS per BACKBONE §14 Stage 0 checklist).
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates libvips \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY server/package.json server/
COPY app/package.json app/
RUN npm ci --omit=dev
COPY --from=build /repo/shared/dist shared/dist
COPY --from=build /repo/server/dist server/dist
# drizzle-kit migrate (run via `docker compose exec api npm -w server run
# db:migrate`) needs its own config file plus the actual migration SQL/journal
# — neither is part of the compiled dist/ output above. `migrate` itself
# doesn't read the `schema` path the config references (only `generate`/
# `push` do), but src/db/ is copied too anyway — a few KB of TS source, cheap
# insurance against drizzle-kit resolving it for some reason we didn't trace.
COPY server/drizzle.config.ts server/
COPY server/drizzle server/drizzle
COPY server/src/db server/src/db
# Run unprivileged, as the `node` user (uid 1000) the base image ships.
# Audited 2026-11-18 — everything this container writes:
#   - media processing / backfill / probe scripts: mkdtemp(os.tmpdir()) =
#     /tmp, world-writable;
#   - `docker compose exec api npm ...` (migrate, invite, owner, backup.js):
#     they read dist/ + talk to Postgres/R2 + stdin/stdout; npm's own logs go
#     to $HOME=/home/node, which the base image owns for this user;
#   - no volumes are mounted into this service (docker-compose.yml).
# Everything else (/repo, node_modules) stays root-owned and read-only to
# the process, which is the point. If a new feature writes to disk, give it
# a path under /tmp or pre-create + chown it here.
USER node
EXPOSE 3000
# Simple healthcheck against the /health route.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/dist/server.js"]

# ─── Den environment (copy to .env; never commit .env) ──────────────────────

# Core
NODE_ENV=development
# Public origin of the app (locked production domain — see BACKBONE §5 rpID trap)
PUBLIC_ORIGIN=https://den.ems-place.com
# API listen
API_HOST=0.0.0.0
API_PORT=3000

# Postgres
# Host port the compose postgres publishes on 127.0.0.1 (change if 5432 is taken
# locally). DATABASE_URL below must match it for host-side tooling.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://den:den@localhost:5432/den
POSTGRES_USER=den
POSTGRES_PASSWORD=den
POSTGRES_DB=den

# Sessions
# 32+ byte random string; used to sign the session cookie
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_DOMAIN=den.ems-place.com

# Who is calling? (docs/AUTH_HARDENING.md §2.1)
#   none       — the socket peer. Unforgeable, and the default for that reason.
#   cloudflare — CF-Connecting-IP (Cloudflare reaches the origin intact).
#   xff        — the RIGHTMOST X-Forwarded-For entry (exactly one trusted proxy).
# ⚠️ As of 2026-08-26 the real client IP does NOT survive prod's
# Cloudflare → VPS → frp → Caddy chain, so `none` is honest rather than
# conservative. Sign in and GET /api/debug/client-ip to see which header (if
# any) actually carries the client, then set this to match.
TRUSTED_PROXY=none
# Fastify's own req.ip rewriting. Leave false unless a proxy you control is
# setting X-Forwarded-For — `true` means "believe the leftmost entry", which
# any caller can write.
TRUST_PROXY=false

# Web Push (VAPID) — generate with: npm run vapid:gen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ems-place.com

# Object storage (media) — Stage 3.
# Local dev: leave these defaults — they point at the docker-compose MinIO
# service (S3-compatible stand-in for R2, `deploy/docker-compose.yml`).
# Prod: point R2_ENDPOINT at the real Cloudflare R2 account endpoint
# (https://<account_id>.r2.cloudflarestorage.com), set real credentials, and
# leave R2_PUBLIC_ENDPOINT unset (R2's endpoint is already browser-reachable).
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=den-dev
R2_SECRET_ACCESS_KEY=den-dev-secret
R2_BUCKET=den-media
R2_FORCE_PATH_STYLE=true

# ─── Vault connector (docs/EMBEDS.md) ───────────────────────────────────────
# REQUIRED IN PROD — the api refuses to boot without it (server/src/env.ts's
# `required()` throws during module evaluation, so a missing value is a crash
# loop, not a degraded feature). Encrypts the OAuth tokens stored in
# `vault_links`; generate with `openssl rand -hex 32`. Keep it STABLE —
# rotating it makes every existing Vault link undecryptable and users must
# re-link. Dev falls back to a throwaway default.
VAULT_TOKEN_ENC_KEY=generate_with_openssl_rand_hex_32

# Optional. The higher tier of Vault trust: only this token can create groups,
# own documents and manage membership. Vault mints it once, in plaintext, via
# `scripts/seed-service.mjs --slug den --name "Den"`. Leaving it unset degrades
# the chat Stage to read-only rather than breaking it.
VAULT_SERVICE_TOKEN=generated_token_from_vault

# REQUIRED for linking. Den must be a REGISTERED OAuth client of Vault; there
# is no sensible default because Vault mints ids as `mcp_<random>` (RFC 7591
# dynamic registration). Register once, with the redirect URI matching
# EXACTLY what Den sends — Vault compares by literal string equality, so a
# trailing slash or an http/https mismatch fails as "Unknown client":
#
#   curl -X POST https://vault.ems-place.com/oauth/register \
#     -H 'content-type: application/json' \
#     -d '{"client_name":"Den",
#          "redirect_uris":["https://den.ems-place.com/api/integrations/vault/callback"],
#          "scope":"vault.documents"}'
#
# Put the returned `client_id` here. Unset ⇒ linking is disabled (Den returns
# its own clear 503) rather than bouncing users off Vault's error page.
VAULT_CLIENT_ID=mcp_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides — defaults are fine for the standard single-host setup.
# VAULT_ISSUER=https://vault.ems-place.com
# VAULT_REDIRECT_URI=   # defaults to ${PUBLIC_ORIGIN}/api/integrations/vault/callback
#                       # If you set it, the value registered above must match it exactly.

# ── GIFs (docs/GIFS.md) ──────────────────────────────────────────────────────
# Klipy test/production API key, from partner.klipy.com -> API Keys.
# SERVER-ONLY, and not by convention: Klipy carries the key in the URL *path*,
# so any client-side call would leak it via request URLs, referrers and
# devtools. Unset => the GIF picker is hidden and /api/gifs/* returns 503; the
# rest of Den is unaffected (server/src/env.ts, `gifsEnabled`).
KLIPY_API_KEY=
